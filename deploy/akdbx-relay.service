[Unit]
Description=akdbx relay (forwards encrypted TLS connections to akdbx brokers)
Documentation=https://github.com/7bgsbm749g-boop/akdbx-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=akdbx-relay
Group=akdbx-relay
# 0600 root:root; systemd reads it before it drops privileges.
EnvironmentFile=/etc/akdbx-relay/relay.env
ExecStart=/opt/akdbx-relay/venv/bin/akdbx-relay
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s

# State (SQLite and the ACME account key) in /var/lib/akdbx-relay, mode 0700.
StateDirectory=akdbx-relay
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=65536

# Hardening. Port 8443 is above 1024, so the service needs no capabilities.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
DevicePolicy=closed
KeyringMode=private

[Install]
WantedBy=multi-user.target
