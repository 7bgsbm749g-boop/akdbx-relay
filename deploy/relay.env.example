# akdbx relay settings. Install as /etc/akdbx-relay/relay.env, mode 0600,
# owner root. Every variable is optional except the two Cloudflare values,
# which certificate issuance needs. See README.md for the full list.

# Cloudflare API token with only "Zone / DNS / Edit" on the akdbx.link zone.
AKDBX_RELAY_CLOUDFLARE_API_TOKEN=
# Zone id of akdbx.link (Cloudflare dashboard, zone overview page).
AKDBX_RELAY_CLOUDFLARE_ZONE_ID=

# "production", "staging", or the URL of another ACME directory.
# Use staging until a test broker works end to end.
AKDBX_RELAY_ACME_DIRECTORY=staging
# Optional contact address for Let's Encrypt expiry and policy mail.
AKDBX_RELAY_ACME_EMAIL=

AKDBX_RELAY_DOMAIN=akdbx.link
# Addresses of the public listener. With port 443 these must be addresses
# where nothing else uses port 443: the relay's own IPv4 and the host IPv6,
# not 0.0.0.0 or :: when Caddy listens on 443 on another address.
AKDBX_RELAY_PUBLIC_HOSTS=192.0.2.10,2001:db8::10
AKDBX_RELAY_PUBLIC_PORT=443
# Optional extra public listeners (IP:PORT or [IPv6]:PORT, comma-separated)
# with the same behavior. Use them to keep the old port 8443 open while
# brokers move to 443; remove them when the move is done.
#AKDBX_RELAY_PUBLIC_EXTRA_LISTEN=192.0.2.10:8443,[2001:db8::10]:8443
# The control API is served on the public port for this SNI name, with TLS
# terminated by the relay (DNS only; never behind a TLS-terminating proxy).
AKDBX_RELAY_CONTROL_HOSTNAME=relay.akdbx.link
# Leave both empty: the relay gets and renews its own certificate through
# ACME and keeps control-chain.pem and control-key.pem (0600) in
# /var/lib/akdbx-relay. Set both to use operator-supplied files instead.
AKDBX_RELAY_CONTROL_CERT_FILE=
AKDBX_RELAY_CONTROL_KEY_FILE=
# Plain-HTTP health check (GET /api/v1/health only), loopback only.
AKDBX_RELAY_HEALTH_HOST=127.0.0.1
AKDBX_RELAY_HEALTH_PORT=8771
AKDBX_RELAY_STATE_PATH=/var/lib/akdbx-relay/relay.sqlite3
AKDBX_RELAY_ACME_ACCOUNT_KEY_FILE=/var/lib/akdbx-relay/acme-account.pem
# Seconds for a whole certificate request (queue wait plus ACME order).
AKDBX_RELAY_CERTIFICATE_DEADLINE=90

AKDBX_RELAY_CERT_BUDGET=40
AKDBX_RELAY_CERT_HARD_LIMIT=48
AKDBX_RELAY_REGISTRATIONS_PER_IP_DAY=5
AKDBX_RELAY_LOG_LEVEL=INFO
